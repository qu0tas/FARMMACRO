{
  "schemaVersion": 1,
  "id": "farmmacro",
  "version": "${version}",
  "name": "Kaelix",
  "description": "Kaelix — farm macro recorder and route walker with an emergency stop (panic)",
  "authors": ["Vadik"],
  "license": "MIT",
  "icon": "assets/farmmacro/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.farmmacro.FarmMacroMod"]
  },
  "mixins": ["farmmacro.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "~${minecraft_version}"
  }
}
